diff --git a/astrbot/dashboard/services/chatbox_context.py b/astrbot/dashboard/services/chatbox_context.py
new file mode 100644
--- /dev/null
+++ b/astrbot/dashboard/services/chatbox_context.py
@@ -0,0 +1,203 @@
+"""Read-only preview and at-most-once admission for explicit WebChat context."""
+
+import json
+
+from astrbot.core.astr_main_agent_resources import (
+    CHATUI_INLINE_GENUI_SYSTEM_PROMPT, CHATUI_SPECIAL_DEFAULT_PERSONA_PROMPT,
+    LLM_SAFETY_MODE_SYSTEM_PROMPT, TOOL_CALL_PROMPT,
+)
+from types import SimpleNamespace
+from uuid import UUID
+
+from fastapi.responses import StreamingResponse
+
+from astrbot.core.agent.webchat_selection import (
+    ContextSelection, SelectionError, digest, provider_identity, select_history, wire_estimate,
+)
+from astrbot.core.config.agent_runner import normalize_agent_runner
+from astrbot.dashboard.responses import ApiError, ok
+from astrbot.dashboard.services.auth_service import CHAT_ADMIN_SCOPE
+from astrbot.dashboard.services.chat_service import build_webchat_unified_msg_origin, extract_platform_message_text
+from astrbot.dashboard.services.open_api_service import OpenApiServiceError
+
+
+def preview_tool_schema(plugin_ctx, conf, persona, provider, umo):
+    """Use the native selection and schema builders without executing tools or hooks."""
+    from astrbot.core.astr_main_agent import (
+        MainAgentBuildConfig, _add_configured_web_search_tools, _apply_local_env_tools,
+        _apply_persona_tools, _apply_sandbox_tools, _apply_web_search_citation_prompt,
+        _plugin_tool_fix, _proactive_cron_job_tools,
+    )
+    from astrbot.core.provider.entities import ProviderRequest
+    from astrbot.core.tools.knowledge_base_tools import KnowledgeBaseQueryTool
+    from astrbot.core.tools.message_tools import SendMessageToUserTool
+
+    req = ProviderRequest(system_prompt="")
+    settings = conf["provider_settings"]
+    manager = plugin_ctx.get_llm_tool_manager()
+    _apply_persona_tools(req, persona, plugin_ctx)
+    if conf.get("kb_agentic_mode", False):
+        req.func_tool.add_tool(manager.get_builtin_tool(KnowledgeBaseQueryTool))
+    plugins = conf.get("plugin_set", ["*"])
+    event = SimpleNamespace(plugins_name=None if plugins == ["*"] else plugins,
+                            get_platform_name=lambda: "webchat")
+    _plugin_tool_fix(event, req)
+    _add_configured_web_search_tools(req, plugin_ctx, settings)
+    runtime = settings.get("computer_use_runtime", "none")
+    if runtime == "local":
+        _apply_local_env_tools(req, plugin_ctx)
+    elif runtime == "sandbox":
+        cfg = MainAgentBuildConfig(sandbox_cfg=settings.get("sandbox", {}))
+        _apply_sandbox_tools(cfg, req, umo, configure_environment=False)
+    if settings.get("proactive_capability", {}).get("add_cron_tools", True):
+        _proactive_cron_job_tools(req, plugin_ctx)
+    req.func_tool.add_tool(manager.get_builtin_tool(SendMessageToUserTool))
+    _apply_web_search_citation_prompt(event, req)
+    modalities = provider.provider_config.get("modalities")
+    if modalities and "tool_use" not in modalities:
+        return [], req.system_prompt
+    return req.func_tool.openai_schema(omit_empty_parameter_field="gemini" in provider.get_model().lower()), req.system_prompt
+
+
+async def context_request(data, auth, service, chat, *, sending):
+    username = data["username"].strip() if auth.via == "api_key" else auth.username
+    sid = data["session_id"].strip()
+    if not sid or not username or "!" in sid or "!" in username:
+        raise ApiError("会话标识无效。")
+    if auth.via == "api_key":
+        try:
+            await service.validate_chat_username(username, allow_admin_username=(
+                "*" in auth.scopes or CHAT_ADMIN_SCOPE in auth.scopes))
+        except OpenApiServiceError as exc:
+            raise ApiError(str(exc), 403) from exc
+    session = await chat.db.get_platform_session_by_id(sid)
+    if session and (session.creator != username or session.is_group or session.platform_id != "webchat"):
+        raise ApiError("会话不属于此用户或不是 WebChat 私聊。", 403)
+    new_session = session is None
+    session = session or SimpleNamespace(creator=username, session_id=sid, platform_id="webchat", is_group=False)
+    records = await chat.get_sorted_platform_history(session)
+    if new_session and records:
+        raise ApiError("会话归属无法核实。", 403)
+    if len(records) >= 100000:
+        raise ApiError("历史记录过多，无法核实完整范围。", 409)
+    umo = build_webchat_unified_msg_origin(session)
+    settings = data["context"]
+    message = data["message"]
+    if sending:
+        turn_id = str(UUID(str(data["turn_id"])))
+        receipt = digest([umo, auth.api_key_id, message, settings, data["revision"]])
+        prior = [r for r in records if r.llm_checkpoint_id == turn_id]
+        if prior:
+            user_rows = [r for r in prior if r.content.get("type") == "user"]
+            if len(user_rows) != 1 or user_rows[0].content.get("chatbox_receipt") != receipt:
+                raise ApiError("turn_id 已用于另一个请求。", 409)
+            if chat.get_active_chat_runs(username, sid):
+                raise ApiError("此请求仍在运行。", 409)
+            bot_rows = [r for r in prior if r.content.get("type") == "bot"]
+            cid = await chat.conv_mgr.get_curr_conversation_id(umo)
+            conv = await chat.conv_mgr.get_conversation(umo, cid) if cid else None
+            history = json.loads(conv.history) if conv else []
+            from astrbot.core.agent.message import get_checkpoint_id
+            saved = [m for m in history if get_checkpoint_id(m) == turn_id]
+            answer = "".join(extract_platform_message_text(r.content) for r in bot_rows)
+            if not answer or len(saved) != 1 or saved[0].get("_chatbox_completed") != digest(answer):
+                raise ApiError("此请求已受理，尚无完整可重放的回复。", 409)
+            # Replaying media or tool activity as plain text would be misleading.
+            if any(part.get("type") not in ("plain", "think") for r in bot_rows for part in r.content["message"]):
+                raise ApiError("此请求已处理，请在会话中查看完整回复。", 409)
+            async def replay():
+                for event in ({"type": "plain", "data": answer}, {"type": "end", "data": ""}):
+                    yield "data: " + json.dumps(event, ensure_ascii=False) + "\n\n"
+            return StreamingResponse(replay(), media_type="text/event-stream")
+    plugin_ctx = chat.core_lifecycle.star_context
+    conf = plugin_ctx.get_config(umo=umo)
+    # Match the ordinary pipeline. External runners maintain private model history.
+    result = dict(supported=False, canSend=False, revision="", reason="", selected=[])
+    try:
+        runner = normalize_agent_runner(conf.get("agent_runner"))
+        if runner["runner_type"] != "local" or not conf["provider_settings"]["enable"]:
+            raise SelectionError("当前运行器未验证上下文选择。")
+        if runner["config"].get("misc", {}).get("tool_schema_mode", "full") != "full":
+            raise SelectionError("当前工具模式未验证上下文选择。")
+        provider = await plugin_ctx.get_using_provider_async(umo=umo)
+        provider_key = provider_identity(provider, runner["config"].get("compression", {}).get("fallback_max_tokens", 128000))
+        result["supported"] = True
+        cid = await chat.conv_mgr.get_curr_conversation_id(umo) or ""
+        conv = await chat.conv_mgr.get_conversation(umo, cid) if cid else None
+        if cid and not conv:
+            raise SelectionError("原生会话无法读取。")
+        history = json.loads(conv.history) if conv else []
+        if not isinstance(history, list):
+            raise SelectionError("原生模型历史格式无法验证。")
+        keep, selected, projected, group_costs = select_history(history, records, settings)
+        history_hash = digest(history)
+        limit = provider_key[3]
+        _, persona, _, default_webchat = await plugin_ctx.persona_manager.resolve_selected_persona(
+            umo=umo, conversation_persona_id=conv.persona_id if conv else None, platform_name="webchat",
+            provider_settings=conf["provider_settings"])
+        persona = persona or {}
+        begin = persona.get("_begin_dialogs_processed") or []
+        system = CHATUI_INLINE_GENUI_SYSTEM_PROMPT + TOOL_CALL_PROMPT
+        if persona.get("prompt"):
+            system += "\n# Persona Instructions\n\n" + persona["prompt"]
+        elif default_webchat:
+            system += CHATUI_SPECIAL_DEFAULT_PERSONA_PROMPT
+        persona_cfg = runner["config"]["persona"]
+        if persona_cfg["safety_mode"] and persona_cfg["safety_mode_strategy"] == "system_prompt":
+            system += LLM_SAFETY_MODE_SYSTEM_PROMPT
+        schemas, tool_prompt = preview_tool_schema(plugin_ctx, conf, persona, provider, umo)
+        fixed = [{"role": "system", "content": system + tool_prompt}, *begin, {"role": "user", "content": message}]
+        extra = dict(provider.provider_config.get("custom_extra_body") or {})
+        parameters = {"model": provider.get_model()}
+        provider._apply_provider_specific_request_overrides(parameters, extra)
+        reserve = extra.get("max_completion_tokens") or extra.get("max_tokens") or parameters.get("max_tokens") or 0
+        revision = digest([username, auth.api_key_id, sid, cid, message, settings, sorted(keep),
+                           history_hash, selected, provider_key, digest(fixed), digest(schemas), reserve])
+        if type(reserve) is not int or reserve < 0:
+            raise SelectionError("提供商输出预留无法核实。")
+        cost = wire_estimate(fixed[:1] + projected + fixed[1:], schemas) + reserve
+        result.update(revision=revision, selected=selected, estimate=True, estimatedTokens=cost,
+                      maxTokens=limit or None, recent=settings["recent"])
+        if limit and cost >= limit:
+            fitting = []
+            used = cost - sum(group_costs)
+            for item, group_cost in zip(selected, group_costs, strict=True):
+                used += group_cost
+                if used >= limit:
+                    break
+                fitting.append(item)
+            result["fittingVisibleMessagesEstimate"] = fitting
+            if cost - sum(group_costs) >= limit:
+                raise SelectionError(
+                    f"仅当前问题与服务配置已预计达到上限 {limit} tokens。请缩短当前问题。"
+                    "若仍超限，请减少服务启用的工具、降低输出预留，或选用上下文窗口更大的模型。")
+            raise SelectionError(f"请求连同已配置工具和输出预留预计 {cost} tokens，配置上限 {limit}。"
+                                 f"计入历史工具调用后，预计可容纳前 {len(fitting)} 条；请减少轮数或移除固定项。")
+        if chat.get_active_chat_runs(username, sid):
+            raise SelectionError("该会话有请求正在运行，请在完成后重新预览。")
+        if not message.strip():
+            raise SelectionError("请输入当前问题。")
+        near = bool(limit and cost >= limit * 0.85)
+        result.update(canSend=True, nearLimit=near, reason=(
+            f"模型容量预计不足：所选历史和问题约 {cost} tokens，配置上限 {limit}。可减少轮数或移除固定项。"
+            if near else "估算含所选历史、当前问题、人格及示例、已启用的工具定义和输出预留。插件在运行时追加的内容将在模型请求前复核。"))
+    except SelectionError as exc:
+        result["reason"] = str(exc)
+    except (ValueError, KeyError, TypeError):
+        result["reason"] = "原生配置或模型历史格式无法核实。"
+    if not sending:
+        return ok(result)
+    if not result["canSend"] or data["revision"] != result["revision"]:
+        raise ApiError(result["reason"] if not result["canSend"] else "预览已过期，请重新预览。", 409)
+    selection = ContextSelection(revision, umo, cid, history_hash, message, provider_key, keep,
+                                 len(begin), digest(begin))
+    if new_session:
