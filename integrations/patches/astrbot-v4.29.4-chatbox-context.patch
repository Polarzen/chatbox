diff --git a/astrbot/core/agent/webchat_selection.py b/astrbot/core/agent/webchat_selection.py
new file mode 100644
--- /dev/null
+++ b/astrbot/core/agent/webchat_selection.py
@@ -0,0 +1,272 @@
+"""Explicit request-local WebChat history selection for the local OpenAI runner."""
+
+import hashlib
+import json
+from dataclasses import dataclass
+
+from astrbot.core.agent.context.token_counter import EstimateTokenCounter
+from astrbot.core.agent.message import Message, get_checkpoint_id
+
+
+class SelectionError(ValueError):
+    pass
+
+
+def digest(value):
+    data = json.dumps(value, ensure_ascii=False, separators=(",", ":"), sort_keys=True)
+    return hashlib.sha256(data.encode()).hexdigest()
+
+
+def provider_identity(provider, fallback_limit=0):
+    from astrbot.core.provider.sources.openai_source import ProviderOpenAIOfficial
+
+    if type(provider) is not ProviderOpenAIOfficial:
+        raise SelectionError("当前提供商未验证上下文选择。")
+    config = provider.provider_config
+    if set(config.get("custom_extra_body") or {}) & {"messages", "model", "tools", "stream"}:
+        raise SelectionError("提供商额外参数覆盖模型请求。")
+    from astrbot.core.utils.llm_metadata import LLM_METADATAS
+    limit = config.get("max_context_tokens") or (LLM_METADATAS.get(provider.get_model()) or {}).get("limit", {}).get("context") or fallback_limit
+    return (config["id"], provider.get_model(), config.get("api_base", ""),
+            limit, digest(config.get("custom_extra_body")))
+
+
+def native_rounds(history):
+    """Map checkpoints to runtime indices. Checkpoints themselves never reach the LLM."""
+    rounds = {}
+    current = []
+    index = 0
+    for item in history:
+        if not isinstance(item, dict):
+            raise SelectionError("原生历史格式无法验证。")
+        if item.get("role") == "_checkpoint":
+            checkpoint = get_checkpoint_id(item)
+            if not checkpoint or checkpoint in rounds:
+                raise SelectionError("原生历史检查点重复或缺失。")
+            rounds[checkpoint] = current
+            current = []
+        else:
+            current.append((index, item))
+            index += 1
+    if current:
+        raise SelectionError("原生历史末尾缺少检查点。")
+    return rounds
+
+
+def check_tool_bundle(messages):
+    pending = set()
+    for item in messages:
+        role = item["role"]
+        if role == "tool":
+            tool_id = item.get("tool_call_id")
+            if tool_id not in pending:
+                raise SelectionError("历史工具结果无法匹配调用。")
+            pending.remove(tool_id)
+        else:
+            if pending:
+                raise SelectionError("历史工具调用缺少结果。")
+            if calls := item.get("tool_calls"):
+                if role != "assistant" or not isinstance(calls, list):
+                    raise SelectionError("历史工具调用格式无法验证。")
+                ids = [c.get("id") if isinstance(c, dict) else None for c in calls]
+                if not all(isinstance(i, str) and i for i in ids) or len(set(ids)) != len(ids):
+                    raise SelectionError("历史工具调用标识缺失或重复。")
+                pending = set(ids)
+    if pending:
+        raise SelectionError("历史工具调用缺少结果。")
+
+
+def token_estimate(messages):
+    counter = EstimateTokenCounter()
+    return counter.count_tokens([Message.model_validate(m) for m in messages]) + 4 * len(messages)
+
+
+@dataclass(frozen=True)
+class ContextSelection:
+    revision: str
+    umo: str
+    cid: str
+    history_hash: str
+    message: str
+    provider_key: tuple
+    indices: frozenset
+    begin_count: int = 0
+    begin_hash: str = digest([])
+
+    async def verify_current(self, manager, request):
+        cid = await manager.get_curr_conversation_id(self.umo)
+        if not request.conversation or cid != request.conversation.cid:
+            raise SelectionError("当前会话已切换，请重新预览。")
+        conv = await manager.get_conversation(self.umo, cid)
+        if not conv or digest(json.loads(conv.history)) != self.history_hash:
+            raise SelectionError("原生历史已变化，请重新预览。")
+
+    def bind(self, request, provider, umo, history):
+        if (umo != self.umo or not request.conversation
+                or self.cid and self.cid != request.conversation.cid
+                or not isinstance(request.contexts, list)
+                or digest(request.contexts[:self.begin_count]) != self.begin_hash
+                or digest(request.contexts[self.begin_count:]) != self.history_hash
+                or digest(json.loads(request.conversation.history)) != self.history_hash):
+            raise SelectionError("历史或请求钩子已改变上下文，请重新预览。")
+        if provider_identity(provider) != self.provider_key or request.model not in (None, "", self.provider_key[1]):
+            raise SelectionError("选择的模型已变化，请重新预览。")
+        if request.prompt != self.message or request.image_urls or request.audio_urls:
+            raise SelectionError("当前问题已被转换，无法验证。")
+        # Verify the complete prefix including the current question on each agent step.
+        prefix = [m.model_dump() for m in history]
+        start = int(bool(request.system_prompt)) + self.begin_count
+        end = len(prefix) - 1
+        if end < start or prefix[end]["role"] != "user":
+            raise SelectionError("无法定位当前问题。")
+        current = prefix[end]["content"]
+        parts = [current] if isinstance(current, str) else [p.get("text") for p in current if p.get("type") == "text"]
+        if parts.count(self.message) != 1:
+            raise SelectionError("无法确认当前问题恰好发送一次。")
+        keep = [i for i in range(end) if i < start or i - start in self.indices]
+        return ProviderView(prefix, keep)
+
+
+@dataclass
+class ProviderView:
+    prefix: list
+    keep: list
+
+    def project(self, messages):
+        n = len(self.prefix)
+        if [m.model_dump() for m in messages[:n]] != self.prefix:
+            raise SelectionError("运行中的历史被修改，请重新预览。")
+        return [messages[i] for i in self.keep] + messages[n - 1:]
+
+
+def verified_turns(records):
+    """Index prompt/reply pairs without treating attachments as plain text."""
+    rows = {}
+    unlinked = set()
+    filenames = {}
+    for record in records:
+        kind = record.content.get("type")
+        if kind not in ("bot", "user"):
+            continue
+        parts = record.content.get("message") or []
+        text = "".join(p.get("text", "") for p in parts if p.get("type") == "plain")
+        if not record.llm_checkpoint_id:
+            if kind == "user":
+                unlinked.add(text)
+            continue
+        row = rows.setdefault(record.llm_checkpoint_id, {"user": [], "bot": [], "plain": True})
+        row[kind].append(text)
+        if kind == "user":
+            filenames.setdefault(record.llm_checkpoint_id, set()).update(
+                p["filename"] for p in parts if p.get("type") == "file" and isinstance(p.get("filename"), str))
+        if any(p.get("type") not in ("plain", "think", "tool_call", "tool_call_result") for p in parts):
+            row["plain"] = False
+    indexed = {}
+    for key, row in rows.items():
+        if len(row["user"]) == 1 and row["bot"]:
+            indexed[key] = (row["user"][0], "".join(row["bot"]), row["plain"])
+        elif len(row["user"]) != 1:
+            unlinked.update(row["user"])
+    return indexed, unlinked, filenames
+
+
+def select_history(history, records, settings):
+    """Hints prove locally held display text. Only pins and N select model input."""
+    indexed, unlinked, filenames = verified_turns(records)
+    by_pair = {}
+    for key, (question, answer, _) in indexed.items():
+        by_pair.setdefault((question, answer), []).append(key)
+    native = native_rounds(history)
+    recent = settings["recent"]
+    completed = [key for key, entries in native.items()
+                 if entries and entries[-1][1].get("role") == "assistant" and not entries[-1][1].get("tool_calls")]
+    if recent and set(list(indexed)[-recent:]) - native.keys():
+        raise SelectionError("最近轮次在原生历史中缺失，请减少轮数。")
+    required = {key: {"user", "assistant"} for key in completed[-recent:]} if recent else {}
+    if required.keys() - indexed.keys():
+        raise SelectionError("最近轮次无法与已保存的聊天记录核实。")
+    evidence = {}
+    for hint in [*settings.get("hints", []), *settings["pins"]]:
+        pair = (hint["question"], hint["answer"])
+        checkpoint = hint.get("checkpoint")
+        if checkpoint:
+            matched = checkpoint in indexed and indexed[checkpoint][:2] == pair
+        else:
+            matches = by_pair.get(pair, [])
+            matched = len(matches) == 1 and pair[0] not in unlinked and indexed[matches[0]][2]
+            checkpoint = matches[0] if matched else None
+        if not matched or checkpoint not in native:
+            if "role" in hint:
+                raise SelectionError("固定消息的原生检查点缺失或不唯一。请刷新记录或移除该固定项。")
+            continue
+        evidence[checkpoint] = hint
+        if "role" in hint:
+            required.setdefault(checkpoint, set()).add(hint["role"])
+
+    keep, selected, costs = set(), [], []
+    for key, entries in native.items():
+        if key not in required:
+            continue
+        turns = [(i, item) for i, item in entries if item["role"] != "system"]
+        roles = [item["role"] for _, item in turns]
+        if (not roles or roles[0] != "user" or roles.count("user") != 1
+                or roles[-1] != "assistant" or turns[-1][1].get("tool_calls")):
+            raise SelectionError("所选轮次尚未完成或边界不明确。")
+        check_tool_bundle([item for _, item in entries])
+        systems = [(i, m) for i, m in entries if m["role"] == "system"]
+        if len(required[key]) == 1 and systems:
+            user_index = turns[0][0]
+            for index, block in systems:
+                content = block.get("content")
+                if (index >= user_index or not isinstance(content, str)
+                        or not content.startswith("File Extract Results of user uploaded files:\n")
+                        or "\nFile Name: " not in content
+                        or content.rsplit("\nFile Name: ", 1)[1] not in filenames.get(key, ())):
+                    raise SelectionError("此轮含无法归属单侧的系统内容，请选择完整问答。")
+            # _apply_file_extract attaches uploaded-file text before this turn's user prompt.
+            if "user" not in required[key]:
+                systems = []
+        for role, field in (("user", "question"), ("assistant", "answer")):
+            if role not in required[key]:
+                continue
+            view = {"role": role, "text": "", "checkpoint": key}
+            if proof := evidence.get(key):
+                view.update(text=proof[field], seq=proof["seq"])
+            selected.append(view)
+            group = systems + [(i, m) for i, m in turns if (m["role"] == "user") == (role == "user")]
+            systems = []
+            keep.update(i for i, _ in group)
+            costs.append(token_estimate([m for _, m in group]))
+    projected = [m for i, m in enumerate(m for m in history if m["role"] != "_checkpoint") if i in keep]
+    return frozenset(keep), selected, projected, costs
+
+
+async def reject_event(event, message):
+    from astrbot.core.platform.sources.webchat.webchat_queue_mgr import webchat_queue_mgr
+
+    event.set_extra("_context_failed", True)
+    await webchat_queue_mgr.put_back_queue(str(event.message_obj.message_id),
+                                          {"type": "error", "data": message})
+
+
+def wire_estimate(messages, tools):
+    wire = json.dumps([messages, tools], ensure_ascii=False, separators=(",", ":"))
+    return token_estimate([{"role": "user", "content": wire}])
+
+
+def verify_wire_budget(provider, payload, extra):
+    limit = provider.provider_config.get("max_context_tokens", 0)
+    messages = payload["messages"]
+    check_tool_bundle(messages)
+    if set(extra) & {"messages", "model", "tools", "stream"}:
+        raise SelectionError("提供商额外参数改变模型请求。")
+    import copy
+    cleaned = copy.deepcopy({"messages": messages})
+    provider._sanitize_assistant_messages(cleaned)
+    if len(cleaned["messages"]) != len(messages):
+        raise SelectionError("提供商将移除所选消息，请调整范围。")
+    # Include the wire-format tool schema, reasoning and metadata. This is an estimate.
+    cost = wire_estimate(messages, payload.get("tools", []))
+    reserve = extra.get("max_completion_tokens") or extra.get("max_tokens") or payload.get("max_tokens") or 0
+    if limit and cost + reserve >= limit:
+        raise SelectionError(f"完整请求预计 {cost} tokens，预留输出 {reserve}，配置上限 {limit}。请减少轮数或移除固定项。")
