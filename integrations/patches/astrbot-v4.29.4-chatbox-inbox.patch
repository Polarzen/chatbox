+
+
+@router.get("/chatbox/inbox", openapi_extra={"x-astrbot-scope": "chat"})
+async def chatbox_inbox(
+    request: Request,
+    username: str = Query(..., max_length=100),
+    session_id: str = Query(..., min_length=1, max_length=100),
+    after: int = Query(0, ge=0, le=9223372036854775807),
+    limit: int = Query(50, ge=1, le=50),
+    auth: AuthContext = Depends(require_chat_scope),
+):
+    grants = Path(get_astrbot_data_path()) / "chatbox-inbox-grants.json"
+    if auth.via != "api_key" or not await asyncio.to_thread(
+        allows, grants, auth.api_key_id, username
+    ):
+        raise ApiError("Chat Box inbox permission required", status_code=403)
+    async with request.app.state.db.get_db() as db:
+        result = await db.execute(text(READ_INBOX), {
+            "sid": session_id, "creator": username, "after": after, "size": limit + 1,
+        })
+        page = inbox_page(result.all(), limit)
+    if page is None:
+        raise ApiError("Chat Box inbox permission required", status_code=403)
+    return JSONResponse(ok(page), headers={"Cache-Control": "no-store"})
