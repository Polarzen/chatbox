+    def _private_admin_peer(self, event: AstrMessageEvent) -> tuple[str, str] | None:
+        pair = self.config.get("private_admin_memory_pair")
+        if not isinstance(pair, list) or len(pair) != 2:
+            return None
+        if not self.config.get("global_memory", True) or not self._get_admin_ids:
+            return None
+        identities = []
+        for value in pair:
+            if not isinstance(value, str) or value.count(":") != 1:
+                return None
+            platform, sender = value.split(":")
+            if any(not part or part != part.strip() for part in (platform, sender)):
+                return None
+            if any(char in value for char in "*?[]"):
+                return None
+            identities.append((platform, sender))
+        parsed = UMOInfo.parse(event.unified_msg_origin)
