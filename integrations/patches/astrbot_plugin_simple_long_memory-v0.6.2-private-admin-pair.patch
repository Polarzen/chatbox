+                catalog_entry = await self.catalog.get_document_by_id(row["metadata"]["kb_doc_id"])
+                self.assertIsNotNone(catalog_entry)
+                self.assertEqual(catalog_entry.doc_name, uri)
+                persisted = vec_db.embedding_storage._read_index(vec_db.embedding_storage.path)
+                vector, status, _ = self.manager._reconstruct_faiss_vector(
+                    persisted, row["id"], self.manager._prepare_faiss_index(persisted)
+                )
+                self.assertEqual((status, vector), ("ok", [0.25, 0.75]))
