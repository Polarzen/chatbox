+"""Exercise the opt-in shared private store with two synthetic admin accounts."""
+
+import asyncio
+import json
+import tempfile
+import unittest
+import uuid
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, patch
+
+import test_private_admin_pair as pair
+from test_memory_sharing import memory
+
+
+class PrivateAdminPoolTests(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        from astrbot.core.db.vec_db.faiss_impl.vec_db import FaissVecDB
+        from astrbot.core.knowledge_base.kb_db_sqlite import KBSQLiteDatabase
+        from astrbot.core.knowledge_base.models import KnowledgeBase
+
+        directory = Path(self.enterContext(tempfile.TemporaryDirectory()))
+        provider = SimpleNamespace(
+            get_dim=lambda: 2, get_embedding=AsyncMock(return_value=[0.25, 0.75])
+        )
+        vec_db = FaissVecDB(str(directory / "doc.db"), str(directory / "index.faiss"), provider)
+        self.addAsyncCleanup(vec_db.close)
+        await vec_db.initialize()
+        self.catalog = KBSQLiteDatabase(str(directory / "catalog.db"))
+        self.addAsyncCleanup(self.catalog.close)
+        await self.catalog.initialize()
+        kb = KnowledgeBase(kb_name="fixture")
+        async with self.catalog.get_db() as session, session.begin():
+            session.add(kb)
+        self.admins = [pair.QQ[1], pair.WEB[1], "third_admin"]
+        config = {
+            "private_admin_memory_pair": list(pair.PAIR), "private_admin_shared_store": True,
+            "global_memory": True, "recall_sparse_fusion": False,
+        }
+        self.manager = pair.MemoryManager(None, config, get_admin_ids=lambda: self.admins)
+        self.manager._sparse_tokenize = False
+        self.manager._kb_helper = SimpleNamespace(
+            kb=kb, kb_db=self.catalog, vec_db=vec_db,
+            get_document=self.catalog.get_document_by_id, refresh_kb=AsyncMock(),
+        )
+        self.qq = pair.AdminEvent(pair.QQ)
+        self.web = pair.AdminEvent(pair.WEB)
+
+    async def documents(self, filters, limit):
+        rows = await self.manager.vec_db.document_storage.get_documents(
+            metadata_filters=filters, limit=limit
+        )
+        return [{**row, "metadata": json.loads(row["metadata"])} for row in rows]
+
+    async def seed(self, *records):
+        for record in records:
+            await self.manager.vec_db.insert(
+                content=record["text"], metadata=record["metadata"], id=str(uuid.uuid4())
+            )
+
+    async def store(self, event, body):
+        return await self.manager.store_memory(event, body, "facts", disclosure="coffee")
+
+    async def assert_readable_set(self, viewer, expected, unavailable=()):
+        expected = set(expected)
+        for source in ("auto_inject", "tool_recall"):
+            with self.subTest(viewer=viewer.unified_msg_origin, source=source):
+                recalled = await self.manager.recall_memories(viewer, "coffee", source=source)
+                self.assertCountEqual([doc["metadata"]["uri"] for doc in recalled], expected)
+
+        listed, total, truncated = await self.manager.list_memories(viewer)
+        self.assertEqual(total, len(expected))
+        self.assertFalse(truncated)
+        self.assertCountEqual([doc["metadata"]["uri"] for doc in listed], expected)
+        for uri in expected:
+            result = await self.manager.get_memory_by_uri(viewer, uri)
+            self.assertIsNotNone(result, uri)
+            self.assertEqual(result["metadata"]["uri"], uri)
+        for uri in unavailable:
+            self.assertIsNone(await self.manager.get_memory_by_uri(viewer, uri), uri)
+
+    async def test_matching_writes_share_one_document_and_distinct_bodies_survive(self):
+        first = await self.store(self.qq, "coffee with oat milk")
+        repeated = await self.store(self.web, "  coffee with oat milk\n")
+        distinct = await self.store(self.web, "coffee after breakfast")
+        self.assertEqual(first, repeated)
+        self.assertNotEqual(first, distinct)
+
+        active = await self.documents({"is_memory_record": True, "deprecated": False}, 10)
+        self.assertCountEqual([doc["metadata"]["uri"] for doc in active], [first, distinct])
+        by_uri = {doc["metadata"]["uri"]: doc for doc in active}
+        for uri, body, writer in (
+            (first, "coffee with oat milk", self.qq),
+            (distinct, "coffee after breakfast", self.web),
+        ):
+            doc = by_uri[uri]
+            self.assertIn(body, doc["text"])
+            self.assertEqual(doc["metadata"]["umo"], writer.unified_msg_origin)
+            self.assertEqual(doc["metadata"]["speaker_id"], writer.get_sender_id())
+        for viewer in (self.qq, self.web):
+            await self.assert_readable_set(viewer, [first, distinct])
+
+    async def test_simultaneous_writes_share_one_active_document(self):
+        left, right = await asyncio.gather(
+            self.store(self.qq, "coffee before noon"),
+            self.store(self.web, "coffee before noon"),
+        )
+        self.assertEqual(left, right)
+        active = await self.documents({"is_memory_record": True, "deprecated": False}, 10)
+        self.assertEqual([doc["metadata"]["uri"] for doc in active], [left])
+        for viewer in (self.qq, self.web):
+            await self.assert_readable_set(viewer, [left])
+
+    async def test_memory_store_tool_reports_the_persisted_uri_to_both_accounts(self):
+        plugin = SimpleNamespace(memory_mgr=self.manager)
+        responses = [
+            await pair.plugin_main.MemoryPlugin.tool_store(plugin, viewer, "coffee beans")
+            for viewer in (self.qq, self.web)
+        ]
+        active = await self.documents({"is_memory_record": True, "deprecated": False}, 10)
+        self.assertEqual(len(active), 1)
+        uri = active[0]["metadata"]["uri"]
+        self.assertEqual(responses, [f"Memory stored: {uri}"] * 2)
+
+    async def test_shared_record_requires_an_authorized_paired_private_event(self):
+        uri = await self.store(self.qq, "coffee beans")
+        for viewer in (
+            pair.AdminEvent(pair.WEB, admin=False),
+            pair.AdminEvent((pair.WEB[0], "outsider"), admin=False),
+            pair.AdminEvent((pair.WEB[0], "third_admin")),
+            pair.AdminEvent(("other_platform", pair.QQ[1])),
+            pair.AdminEvent(pair.QQ, kind="GroupMessage"),
+            pair.AdminEvent(pair.WEB, kind="GroupMessage"),
+        ):
+            with self.subTest(viewer=viewer.unified_msg_origin):
+                await self.assert_readable_set(viewer, [], unavailable=[uri])
+
+        await self.assert_readable_set(self.web, [uri])
+        self.admins.remove(pair.WEB[1])
+        await self.assert_readable_set(self.web, [], unavailable=[uri])
+
+    async def test_legacy_group_and_conversation_memories_stay_out_of_peer_store(self):
+        platform, sender = pair.WEB
+        owner = "_".join(pair.WEB)
+        group = f"{platform}:GroupMessage:fixture_room"
+        group_records = [
+            memory(scope=scope, owner=owner, umo=group, session_type="group",
+                   sender_id=sender, user_id=owner, visibility=visibility, domain="facts",
+                   disclosure="coffee", uri=f"facts://legacy_group_{scope}")
+            for scope, visibility in (("personal", "private"), ("group", "group"))
+        ]
+        conversation = pair.record(pair.WEB, "legacy_conversation", scope="conversation")
+        await self.seed(*group_records, conversation)
+        uris = [doc["metadata"]["uri"] for doc in [*group_records, conversation]]
+        await self.assert_readable_set(self.qq, [], unavailable=uris)
+
+    async def test_simultaneous_edits_of_one_uri_leave_one_active_successor(self):
+        uri = await self.store(self.qq, "coffee at noon")
+        snapshots = [await self.manager.get_memory_by_uri(viewer, uri) for viewer in (self.qq, self.web)]
+        bodies = ["coffee in the morning", "coffee at night"]
+        outcomes = await asyncio.gather(*(
+            self.manager.replace_memory(record["metadata"], body)
+            for record, body in zip(snapshots, bodies)
+        ), return_exceptions=True)
+        successes = {}
+        for outcome, body in zip(outcomes, bodies):
+            if isinstance(outcome, (ValueError, RuntimeError)):
+                self.assertTrue(str(outcome).strip())
+            else:
+                self.assertIsInstance(outcome, str)
+                successes[outcome] = body
+        self.assertTrue(successes)
+        active = await self.documents({"is_memory_record": True, "deprecated": False}, 10)
+        self.assertEqual(len(active), 1)
+        meta = active[0]["metadata"]
+        self.assertEqual(meta["memory_content"], successes[meta["uri"]])
+
+    async def test_edit_to_an_existing_body_preserves_the_existing_record(self):
+        first = await self.store(self.qq, "coffee at noon")
+        second = await self.store(self.web, "coffee at night")
+        old = await self.manager.get_memory_by_uri(self.web, first)
+        try:
+            result = await self.manager.replace_memory(old["metadata"], " coffee at night ")
+        except (ValueError, RuntimeError) as error:
+            self.assertTrue(str(error).strip())
+            expected = {first: "coffee at noon", second: "coffee at night"}
+        else:
+            self.assertEqual(result, second)
+            expected = {second: "coffee at night"}
+        active = await self.documents({"is_memory_record": True, "deprecated": False}, 10)
+        self.assertCountEqual(
+            [(row["metadata"]["uri"], row["metadata"]["memory_content"]) for row in active],
+            expected.items(),
+        )
+
+    async def test_duplicate_retry_restores_persisted_vector_and_catalog_entry(self):
+        vec_db = self.manager.vec_db
+        for target, method in (
+            (vec_db.embedding_storage, "insert"),
+            (vec_db.embedding_storage, "save_index"),
+            (self.manager, "_register_kb_document"),
