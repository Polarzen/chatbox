new file mode 100644
index 0000000..5a45656
--- /dev/null
+++ b/tests/test_private_admin_pair.py
@@ -0,0 +1,179 @@
+"""私聊配对只扩展自动注入，数据与管理员名单均为合成测试夹具。"""
+
+import json
+import unittest
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+from sqlalchemy import text
+from sqlalchemy.ext.asyncio import AsyncSession, create_async_engine
+
+from test_memory_commands import MemoryManager, plugin_main
+from test_memory_sharing import Event, memory
+
+
+QQ = ("qq_fixture", "1001")
+WEB = ("webchat", "chatbox_fixture")
+PAIR = [":".join(QQ), ":".join(WEB)]
+
+
+class AdminEvent(Event):
+    def __init__(self, identity, kind="FriendMessage", admin=True):
+        platform, sender = identity
+        super().__init__(f"{platform}:{kind}:{sender}", sender)
+        self.admin = admin
+
+    def is_admin(self):
+        return self.admin
+
+
+def record(identity, name, **override):
+    platform, sender = identity
+    owner = f"{platform}_{sender}"
+    doc = memory(
+        owner=owner, umo=f"{platform}:FriendMessage:{sender}",
+        sender_id=sender, user_id=owner, session_type="private", session_id=sender,
+        domain="facts", disclosure="coffee", uri=f"facts://{name}", **override,
+    )
+    doc["text"] = f"coffee fixture {name}"
+    return doc
+
+
+class PrivateAdminPairTests(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.admins = [QQ[1], WEB[1], "third_admin"]
+        self.manager = MemoryManager(
+            None, {"private_admin_memory_pair": list(PAIR), "global_memory": True,
+                   "recall_sparse_fusion": False},
+            get_admin_ids=lambda: self.admins,
+        )
+        self.manager._sparse_tokenize = False
+        self.engine = create_async_engine("sqlite+aiosqlite:///:memory:")
+        self.addAsyncCleanup(self.engine.dispose)
+        async with self.engine.begin() as conn:
+            await conn.execute(text(
+                "CREATE TABLE documents (id INTEGER PRIMARY KEY, text TEXT, metadata TEXT)"
+            ))
+        storage = SimpleNamespace(
+            get_session=lambda: AsyncSession(self.engine), get_documents=self.documents
+        )
+        self.manager._kb_helper = SimpleNamespace(vec_db=SimpleNamespace(
+            document_storage=storage, retrieve=AsyncMock(return_value=[]),
+            delete_documents=AsyncMock(),
+        ))
+
+    async def documents(self, metadata_filters, limit, offset=0):
+        where, params = self.manager._filters_to_sql(metadata_filters)
+        async with self.engine.connect() as conn:
+            rows = await conn.execute(text(
+                f"SELECT text, metadata FROM documents WHERE {where} LIMIT :lim OFFSET :off"
+            ), {**params, "lim": limit, "off": offset})
+            return [{"text": r.text, "metadata": json.loads(r.metadata)} for r in rows]
+
+    async def seed(self, *records):
+        async with self.engine.begin() as conn:
+            await conn.execute(text("INSERT INTO documents(text, metadata) VALUES (:t, :m)"),
+                               [{"t": r["text"], "m": json.dumps(r["metadata"])} for r in records])
+
+    async def test_auto_injection_is_bidirectional_and_attributes_the_peer(self):
+        await self.seed(record(QQ, "qq_record"), record(WEB, "web_record"))
+        plugin = SimpleNamespace(
+            memory_mgr=self.manager, config=self.manager.config, _background_tasks=set(),
+            _maybe_expire_stale_memories=AsyncMock(), _maybe_consolidate_memories=AsyncMock(),
+            _accumulate_request_snapshot=lambda *args: None, _get_display_timezone=lambda: "UTC",
+            _get_viewer_user_id=self.manager._current_owner_user_id,
+        )
+        for viewer, own, peer in ((QQ, "qq_record", "web_record"), (WEB, "web_record", "qq_record")):
+            with self.subTest(viewer=viewer):
+                request = SimpleNamespace(prompt="coffee", contexts=[])
+                await plugin_main.MemoryPlugin.inject_memories(plugin, AdminEvent(viewer), request)
+                content = request.contexts[0]["content"]
+                boundaries = content.split("[另一位管理员的个人记忆]")
+                self.assertEqual(len(boundaries), 2, content)
+                self.assertIn(f"coffee fixture {own}", boundaries[0])
+                self.assertNotIn(f"coffee fixture {peer}", boundaries[0])
+                self.assertIn(f"coffee fixture {peer}", boundaries[1])
+                changed = {d["metadata"]["uri"]: d["metadata"].get("recall_count", 0)
