+    async def redirect_uri(self, old_uri: str, new_uri: str) -> None:
+        """Move all edges to a surviving URI, preserving provenance and excluding self-links."""
+        from sqlalchemy import text as sa_text
+
+        params = {"old": old_uri, "new": new_uri}
+        storage = self._vec_db.document_storage
+        async with storage.get_session() as session, session.begin():
+            await session.execute(sa_text(
+                "INSERT OR IGNORE INTO memory_links "
+                "(source_uri,target_uri,relation_type,reason,confidence,created_by,created_at) "
+                "SELECT CASE WHEN source_uri=:old THEN :new ELSE source_uri END,"
+                "CASE WHEN target_uri=:old THEN :new ELSE target_uri END,"
+                "relation_type,reason,confidence,created_by,created_at FROM memory_links "
+                "WHERE (source_uri=:old OR target_uri=:old) AND source_uri!=target_uri "
+                "AND source_uri!=:new AND target_uri!=:new"
+            ), params)
+            await session.execute(sa_text(
+                "DELETE FROM memory_links WHERE source_uri=:old OR target_uri=:old"
+            ), params)
+
     async def delete_links_for_uris(self, uris: list[str]) -> int:
         """级联删除涉及指定 URI 的所有关联边。"""
         uris = [u for u in uris if u]
